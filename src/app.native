<!--
  Wall-E agent shell entry view.
  Layout only: import components, compose three-pane Codex-like shell.
  Logic lives in core.ts + shell/*; mock data in mock/*; never import mock here.
  Cmd/Ctrl+Shift+P toggles the Uber DesignTokens palette (titlebar stays).
-->
<import src="components/titlebar.native"/>
<import src="components/session-card.native"/>
<import src="components/session-sidebar.native"/>
<import src="components/message-user.native"/>
<import src="components/message-assistant.native"/>
<import src="components/compose-bar.native"/>
<import src="components/conversation-pane.native"/>
<import src="components/review-pane.native"/>
<import src="components/palette-pane.native"/>

<column background="background" grow="1" label="Agent shell">
  <use template="titlebar" />
  <separator />

  <if test="{showShell}">
    <split value="{navSplit}" on-resize="nav_resized" gap="1" grow="1">
      <use template="session-sidebar" />
      <split value="{mainSplit}" on-resize="main_resized" gap="1">
        <use template="conversation-pane" />
        <use template="review-pane" />
      </split>
    </split>
  </if>
  <else>
    <use template="palette-pane" />
  </else>
</column>
